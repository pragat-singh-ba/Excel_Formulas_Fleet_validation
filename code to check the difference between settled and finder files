import os
import pandas as pd

# Set your folder path
folder_path = r'C:\Users\PragatSingh\OneDrive - PR Petroleum\Daily Fleet Validation'

# Initialize variables
total_settled_amounts = []

# Loop through all Excel files in the directory
for file in os.listdir(folder_path):
    if file.endswith('.xlsx') or file.endswith('.xls'):
        file_path = os.path.join(folder_path, file)
        try:
            df = pd.read_excel(file_path)
            if 'Settled Amount' in df.columns:
                settled_sum = df['Settled Amount'].sum()
                total_settled_amounts.append(settled_sum)
                print(f"{file}: {settled_sum}")
            else:
                print(f"{file}: 'Settled Amount' column not found.")
        except Exception as e:
            print(f"Error reading {file}: {e}")

# Compare the sums (example: difference between first and last file)
if len(total_settled_amounts) >= 2:
    difference = round(abs(total_settled_amounts[0] - total_settled_amounts[-1]), 2)
    print(f"\nDifference between first and last file's 'Settled Amount': {difference}")
else:
    print("\nNot enough valid Excel files with 'Settled Amount' to compare.")
